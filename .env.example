# Copie para .env e preencha. NUNCA commite o .env real.

# ===== Banco de dados local (PostGIS) =====
DATABASE_URL=postgresql+postgis://postgres:postgres@localhost:5432/alerta_fogo
POSTGRES_DB=alerta_fogo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ===== Google Earth Engine =====
GEE_PROJECT_ID=
GEE_CREDENTIALS_JSON=

# ===== Fontes de focos (ver DECISIONS.md D-004) =====
FIRMS_API_KEY=
INPE_API_KEY=
GOES_AWS_BUCKET=noaa-goes16
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== Sentinel Hub / dNBR =====
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# ===== Canais de entrega (ver DECISIONS.md D-003) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ===== Infraestrutura =====
DEBUG=false
TUNNEL_TOKEN=
PUBLIC_BASE_URL=
