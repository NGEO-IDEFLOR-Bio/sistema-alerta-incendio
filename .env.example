# Copie para .env e preencha. NUNCA commite o .env real.

# ===== Banco de dados local (PostGIS via docker compose) =====
# Driver: psycopg2 (SQLAlchemy). A extensao postgis e criada na migracao Alembic.
# A porta 5433 evita colidir com um Postgres ja instalado na maquina (BUILD.md, armadilha 4).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/alerta_fogo
POSTGRES_DB=alerta_fogo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# ===== Redis (broker do Celery) =====
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ===== Caminhos das camadas de referencia (fora do git) =====
# Padroes: <repo>/data/shapes_de_todas_as_unidades_com_gerencia.geojson e
# <repo>/../visualizador/data/zoneamentos_ucs_estaduais.geojson
#REFERENCIA_UCS=
#REFERENCIA_ZONAS=

# ===== Google Earth Engine =====
GEE_PROJECT_ID=
GEE_CREDENTIALS_JSON=

# ===== Fontes de focos (ver DECISIONS.md D-012) =====
# FIRMS: MAP_KEY gratuita, cadastro em https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=
# INPE Programa Queimadas / BDQueimadas: DADOS ABERTOS, sem chave -> sem INPE_API_KEY
# NOAA GOES-R ABI L2 FDC: bucket publico, sem chave
GOES_AWS_BUCKET=noaa-goes16
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== Sentinel Hub / dNBR =====
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# ===== Canais de entrega (ver DECISIONS.md D-003) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ===== Infraestrutura =====
DEBUG=false
TUNNEL_TOKEN=
PUBLIC_BASE_URL=
